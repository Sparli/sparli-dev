---
/**
 * One labelled box inside a diagram's <svg>. Text is centred on the box, so a
 * box can be moved by changing x/y alone without re-aligning its labels.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h?: number;
  title: string;
  sub?: string;
  /** mine = my layer · bad = the failure · good = the fix or the gate */
  tone?: "mine" | "bad" | "good";
}
const { x, y, w, h = 60, title, sub, tone } = Astro.props;
const cx = x + w / 2;
---

<g class:list={["box", tone]}>
  <rect x={x} y={y} width={w} height={h} rx="4"></rect>
  <text class="t" x={cx} y={sub ? y + h / 2 - 3 : y + h / 2 + 5} text-anchor="middle">{title}</text>
  {sub && <text class="s" x={cx} y={y + h / 2 + 15} text-anchor="middle">{sub}</text>}
</g>
