---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ShurqDiagram from "../components/diagrams/Shurq.astro";

// Sorted by an explicit `order` rather than by date. The first entry is the one
// I most want read, and that is an editorial decision, not a chronological one.
const shipped = (await getCollection("shipped", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Home-page presentation for each case study: the short summary, the one
 * measured outcome, and which drawn clip the media frame shows. Keyed by
 * collection id and checked at build time: a case study without a home-page
 * entry fails the build here rather than silently vanishing from the page
 * that exists to sell it. (Same philosophy as the schema's `evidence` gate.)
 */
const home: Record<
  string,
  { sum: string; sum2?: string; outcomeK: string; outcomeV: string; clip?: "call" | "queue" }
> = {
  "four-second-hangup": {
    sum: `The prospect said &ldquo;hello&rdquo;. Speech-to-text, working on a noisy first
      packet, heard <b>&ldquo;no&rdquo;</b>, and a perfectly reasonable end-call rule did the rest. Two correct behaviours composing into a wrong one. The logs were structurally
      incapable of showing it: every line in them was correct.
      <b>Found by listening to the recordings.</b>`,
    outcomeK: "after",
    outcomeV: "0 false hang-ups",
    clip: "call",
  },
  "agent-that-cannot-email-clients": {
    sum: `A prompt saying &ldquo;always ask before sending&rdquo; is a request, and its failure
      is silent. So the send capability <b>does not exist</b>: no tool emails a client, no tool
      posts to ClickUp. Proposed actions land in a table and wait for a human. The worst case
      stops being a wrong message to a customer and becomes
      <b>a badly worded row that gets rejected</b>.`,
    outcomeK: "today",
    outcomeV: "0 code paths that send",
    clip: "queue",
  },
  "mongolian-speech-legacy-pbx": {
    sum: `The client needed Mongolian speech in a running call flow. No commercial vendor
      offered it, and the telephony side was a live Asterisk/FreePBX install whose audio
      contract could not change: sample rate, encoding, timing, all fixed.
      <b>I built and operated the serving stack; I did not train the models</b>, and I will say
      which part was mine before you ask.`,
    sum2: `A self-hosted FastAPI service running two off-the-shelf speech engines behind one
      interface, with fallback between them, producing audio that dropped straight into the
      existing call flow.`,
    outcomeK: "result",
    outcomeV: "nothing on the telephony side changed",
  },
};

for (const entry of shipped) {
  if (!home[entry.id]) {
    throw new Error(
      `index.astro has no home-page presentation for case study "${entry.id}". ` +
        `Add it to the \`home\` map. Known ids: ${Object.keys(home).join(", ")}`,
    );
  }
}
---

<Base
  bare
  title="Sparli Aman · senior AI engineer, agentic systems"
  description="Agents are easy to demo. Running one in someone else's production is a different job. Tool-using agents wired into ad platforms, CRMs and telephony, behind approval gates, on data pipelines I own."
>
  <div class="band">
    <header class="hero">
      <div class="frame">
        <div>
          <p class="kicker"><b>Sparli Aman</b> · senior AI engineer · agentic systems &amp; data pipelines</p>
          <h1>Agents are easy to demo. Running one in <em>someone else&rsquo;s production</em> is a different job.</h1>
          <p class="lede">
            I build agents that take real actions in ad platforms, CRMs and phone systems, and the
            data pipelines they run on. Four years of that inside one SaaS product, Shurq, from idea
            stage to 200+ concurrent users.
          </p>
          <p class="facts">
            <span><b>7y</b> client-side delivery</span>
            <span>clients in <b>US · CA · UK · Gulf</b></span>
            <span><b>UTC+5</b> · remote or relocation</span>
          </p>
        </div>
        <div class="portrait">
          <img src="/portrait.jpg" alt="Sparli Aman" width="450" height="600" />
          <div class="tint"></div>
          <div class="fade"></div>
          <span class="sig">sparli aman · pakistan → everywhere</span>
        </div>
      </div>
    </header>

    <!-- The hero's "video": the production pipeline, drawn and moving. CSS
         animation only, so it costs zero bytes of JavaScript and zero video
         bytes — which is the point, and the badge says so. -->
    <div class="flow">
      <div class="frame">
        <div class="flowhead">
          <p>How my agents run in production</p>
          <p class="live">live loop · css only, zero js</p>
          <!-- WCAG 2.2.2: anything that moves for more than five seconds needs a
               way to stop it. A checkbox plus :has() pauses every animation on
               the page with no script, so the zero-JS budget still holds. -->
          <label class="pausectl">
            <input type="checkbox" id="motion-pause" />
            <span>pause animation</span>
          </label>
        </div>
        <!-- Focusable because it scrolls sideways on a phone: a keyboard user
             has to be able to reach the part of the diagram that is off screen. -->
        <div class="flowviz" tabindex="0" role="region" aria-label="Agent pipeline diagram">
          <svg
            viewBox="0 0 940 150"
            role="img"
            aria-label="An animated agent pipeline: a task reaches the agent, the agent proposes an action, the action waits in pending_actions, a human approves it, and only then is it executed. The loop repeats."
          >
            <g font-family="ui-monospace,Menlo,monospace">
              <path class="wire" d="M160 62 H208"></path>
              <path class="wire" d="M410 62 H458"></path>
              <path class="wire" d="M660 62 H708"></path>
              <g class="node n1">
                <rect x="10" y="30" width="150" height="64" rx="4"></rect>
                <text class="ttl" x="85" y="57" text-anchor="middle">task arrives</text>
                <text class="sub" x="85" y="76" text-anchor="middle">cron · webhook · call</text>
              </g>
              <g class="node n2">
                <rect x="208" y="30" width="202" height="64" rx="4"></rect>
                <text class="ttl" x="309" y="57" text-anchor="middle">agent proposes</text>
                <text class="sub" x="309" y="76" text-anchor="middle">tools · context · plan</text>
              </g>
              <g class="node n3">
                <rect x="458" y="30" width="202" height="64" rx="4"></rect>
                <text class="ttl" x="559" y="57" text-anchor="middle">pending_actions</text>
                <text class="sub" x="559" y="76" text-anchor="middle">preview · audit row</text>
              </g>
              <g class="node n4">
                <rect x="708" y="30" width="222" height="64" rx="4"></rect>
                <text class="ttl" x="819" y="57" text-anchor="middle">human approves</text>
                <text class="sub" x="819" y="76" text-anchor="middle">then, only then: execute</text>
              </g>
              <circle class="gatechip" cx="916" cy="22" r="5"></circle>
              <g class="status">
                <text class="s1" x="10" y="132">run · drafting a client status email from repo + tickets</text>
                <text class="s2" x="10" y="132">run · action queued: send_report → waiting for approval</text>
                <text class="s3" x="10" y="132">run · approved by human · executed · audit row written</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <section class="row" id="pattern">
    <div class="frame">
      <p class="lab"><b>01</b>The pattern</p>
      <div>
        <h2>Every system I build puts the irreversible action behind a human.</h2>
        <p class="sub">
          Not caution: asymmetry. You cannot recall a bad message to a customer, or unspend an ad
          budget. I have made this call three times, in three unrelated domains, without anyone
          asking me to.
        </p>
        <dl class="ledger">
          <div>
            <dt>Shurq</dt>
            <dd>
              The progressive autonomy ladder I designed: read-only, then approval on every write,
              then earned autonomy under spend caps. Every action returns a preview requiring
              <code>confirm_action</code>, fully audited.
            </dd>
            <dd class="tag2">live ad spend</dd>
          </div>
          <div>
            <dt>Croncore</dt>
            <dd>
              The agent has no tool that sends. Proposed actions land in a
              <code>pending_actions</code> row and wait. The send path does not exist rather than
              being disabled.
            </dd>
            <dd class="tag2">client email</dd>
          </div>
          <div>
            <dt>leadflow-agent</dt>
            <dd>
              Public repo. The model can only propose HubSpot records; the code writes them, and
              only after a human approves. Every write goes to a ledger with one-command undo.
              <a href="https://github.com/Sparli/leadflow-agent">github.com/Sparli/leadflow-agent</a>
            </dd>
            <dd class="tag2">CRM writes</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="row" id="cases">
    <div class="frame">
      <p class="lab"><b>02</b>Case studies</p>
      <div>
        <h2>Three things that broke, and how they were found.</h2>
        <p class="sub">
          Client work under NDA, so these describe architecture and outcomes rather than source. The
          frames below are engineered for screen recordings; until those are exported, each shows
          the actual architecture, drawn and moving.
        </p>

        {
          shipped.map((entry, i) => {
            const h = home[entry.id];
            return (
              <article class="inc">
                <div class="top">
                  <span class="no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{entry.data.title}</h3>
                    <p class="ctx">
                      {entry.data.context} · {entry.data.period}
                    </p>
                  </div>
                </div>
                <div class="body">
                  <div>
                    <p class="sum" set:html={h.sum} />
                    <div class="outcome">
                      <span class="k">{h.outcomeK}</span>
                      <span class="v">{h.outcomeV}</span>
                    </div>
                    <a
                      class="more"
                      href={`/shipped/${entry.id}/`}
                      aria-label={`Read the full write-up: ${entry.data.title}`}
                    >
                      Read the full write-up
                    </a>
                  </div>
                  {h.clip === "call" && (
                    <figure>
                      <div class="clip">
                        <span class="badge">replay · what the caller experienced</span>
                        <svg
                          viewBox="0 0 620 150"
                          role="img"
                          aria-label="Animated call timeline: the call connects, carrier noise precedes the first turn, hello is transcribed as no, and the end-call rule fires around four seconds."
                        >
                          <line x1="30" y1="84" x2="590" y2="84" stroke="var(--d-line2)" stroke-width="2" />
                          <g stroke="var(--d-line2)">
                            <line x1="30" y1="76" x2="30" y2="92" />
                            <line x1="200" y1="76" x2="200" y2="92" />
                            <line x1="390" y1="76" x2="390" y2="92" />
                            <line x1="560" y1="76" x2="560" y2="92" />
                          </g>
                          <circle class="pulse" cx="30" cy="84" r="6" />
                          <g font-family="ui-monospace,Menlo,monospace" font-size="11" fill="#a6abb5">
                            <text x="30" y="64">connect</text>
                            <text x="200" y="64">noise</text>
                            <text x="390" y="64" fill="#e5a53a">&#8220;hello&#8221; → &#8220;no&#8221;</text>
                            <text x="560" y="64" text-anchor="end">end-call</text>
                          </g>
                          <g class="hangup" font-family="ui-monospace,Menlo,monospace">
                            <text x="560" y="118" text-anchor="end" font-size="11" fill="#e5a53a">call terminated · 00:04</text>
                          </g>
                          <text x="30" y="118" font-family="ui-monospace,Menlo,monospace" font-size="10.5" fill="#8b919d">0s</text>
                        </svg>
                      </div>
                      <figcaption>recording slot · the drawn timeline is the real failure sequence</figcaption>
                    </figure>
                  )}
                  {h.clip === "queue" && (
                    <figure>
                      <div class="clip">
                        <span class="badge">replay · the approval queue</span>
                        <svg
                          viewBox="0 0 620 170"
                          role="img"
                          aria-label="Animated approval queue: a proposed action appears as a pending row, a human approves it, and it is marked executed."
                        >
                          <g font-family="ui-monospace,Menlo,monospace" font-size="11">
                            <rect x="30" y="26" width="560" height="30" rx="3" fill="#14171c" stroke="#252932" />
                            <text x="44" y="45" fill="#a6abb5">pending_actions</text>
                            <text x="576" y="45" text-anchor="end" fill="#8b919d">croncore/delivery</text>
                            <g class="rowpulse">
                              <rect x="30" y="66" width="560" height="34" rx="3" fill="#1a2547" stroke="#394050" />
                              <text x="44" y="87" fill="#9eb1ff">draft: status report → client@…  ·  awaiting approval</text>
                            </g>
                            <g class="tick">
                              <rect x="30" y="110" width="560" height="34" rx="3" fill="#10291d" stroke="#1f4a35" />
                              <text x="44" y="131" fill="#3dd68c">✓ approved by human · executed · audit row written</text>
                            </g>
                          </g>
                        </svg>
                      </div>
                      <figcaption>recording slot · the drawn queue is the real mechanism</figcaption>
                    </figure>
                  )}
                  {!h.clip && h.sum2 && (
                    <div>
                      <p class="sum" set:html={h.sum2} />
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="row" id="products">
    <div class="frame">
      <p class="lab"><b>03</b>Products</p>
      <div>
        <h2>Products I build and run, not just demo.</h2>
        <p class="sub">
          Two live products with real users, and one public repo you can read line by line.
          Client work under NDA is in the case studies above.
        </p>
        <dl class="ledger">
          <div>
            <dt>Shurq</dt>
            <dd>
              UK Amazon-analytics SaaS I joined at the idea stage, now a paid product with a 10+
              person team, 200+ concurrent users and 21 marketplaces. I own the hourly data pipeline
              that turns Amazon sales, fee and ad data into true per-product profit. I led and built
              the MCP server (1,080 tools, 29 of them write actions, scoped API keys) and the AI Ad
              Manager, where nothing touches a live ad account without a rule or a human.
              <a href="https://shurq.com">shurq.com</a>
            </dd>
            <dd class="tag2">lead engineer</dd>
          </div>
          <div>
            <dt>EduImmersion</dt>
            <dd>
              Took a Québec EdTech client from raw requirements to two products, now in pilot: a
              learner platform that generates lessons and quizzes by grade, language and pace (with
              a paid tier on Stripe), and a role-based dashboard suite for schools, teachers and
              parents. Both EN/FR, data hosted in Canada. I designed both and built most of the core
              with a small team.
            </dd>
            <dd class="tag2">in pilot</dd>
          </div>
          <div>
            <dt>leadflow-agent</dt>
            <dd>
              A tool-using agent that turns a raw sales enquiry into de-duplicated HubSpot records.
              Pydantic-guarded tools, a human approval step before any write, a ledger with undo,
              cost per run, strict mypy and gitleaks in CI.
              <a href="https://github.com/Sparli/leadflow-agent">github.com/Sparli/leadflow-agent</a>
            </dd>
            <dd class="tag2">public repo</dd>
          </div>
        </dl>
        <ShurqDiagram />
        <div class="shots">
          <figure class="shot">
            <img
              src="/shots/shurq-ai-employees.webp"
              width="1100"
              height="708"
              loading="lazy"
              decoding="async"
              alt="Shurq's AI Workforce screen. An AI employee card for the COO agent, Cortex, shows a trust score out of 100 and three autonomy modes, Observe, Co-pilot and Autopilot. A note says it auto-acts only on Autopilot, with trust of at least 70 and three positive measured outcomes."
            />
            <figcaption>
              shurq · AI employees on the MCP tool layer: they act alone only on Autopilot, at
              trust ≥ 70
            </figcaption>
          </figure>
          <figure class="shot">
            <img
              src="/shots/shurq-workflows.webp"
              width="1100"
              height="548"
              loading="lazy"
              decoding="async"
              alt="Shurq's Ad Manager workflows screen, with an approval queue tab, a note that every write step asks the user first, and starter templates such as Bid Guardrails, ACOS ladder and Pause bleeders."
            />
            <figcaption>
              shurq · Ad Manager workflows: an approval queue, and every write step asks first
            </figcaption>
          </figure>
          <figure class="shot">
            <img
              src="/shots/eduimmersion-network.webp"
              width="1100"
              height="744"
              loading="lazy"
              decoding="async"
              alt="EduImmersion's school-network dashboard for a school service centre in Montreal, showing totals for schools, teachers and students and a table of schools with attendance, assignment and quiz averages."
            />
            <figcaption>
              eduimmersion pilot · the school-network dashboard, EN/FR, shown with demo data
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="row" id="method">
    <div class="frame">
      <p class="lab"><b>04</b>Method</p>
      <div>
        <div class="pos">
          <div>
            <h3>Measure on the real path, not the benchmark</h3>
            <p>
              I moved a production voice agent between models because latency on live calls was
              too high, not because of a leaderboard. Same instinct: stress-testing to 200+
              concurrent users before release, not after.
            </p>
          </div>
          <div>
            <h3>The gate is architecture, not a prompt</h3>
            <p>
              A system prompt is a request. A missing code path is a guarantee. When the failure
              is irreversible, I build the guarantee.
            </p>
          </div>
          <div>
            <h3>Compliance is part of the build</h3>
            <p>
              Dialling windows, DNC scrubbing, consent logging, CASL unsubscribe: built in-house,
              per jurisdiction, because the penalty lands on the client&rsquo;s phone numbers.
            </p>
          </div>
          <div>
            <h3>Say what I did not do</h3>
            <p>
              I build, integrate, deploy and operate these systems. I do not train models, and
              where a project involved one I will tell you which part was mine.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="row" id="stack">
    <div class="frame">
      <p class="lab"><b>05</b>In production with</p>
      <div>
        <p class="stackline">
          <b>Twilio</b> · <b>Asterisk/FreePBX</b> · <b>Deepgram</b> · <b>ElevenLabs</b> ·
          <b>Pipedrive</b> · <b>ClickUp</b> · <b>GitHub</b> · <b>Gmail</b> ·
          <b>HubSpot</b> · <b>Amazon Ads &amp; SP-API</b> · <b>BigQuery</b> · <b>MCP</b> ·
          <b>Meta Ads</b> · <b>Google Places</b> · <b>Stripe</b>.
          Each wired up and debugged in production, not read about.
        </p>
      </div>
    </div>
  </section>

  <div class="colophon">
    <div class="frame">
      <p class="kicker"><b>06</b> · Colophon</p>
      <h2>This site is built the way I build client systems.</h2>
      <p class="sub">
        The claims above are the kind that should be checkable, so the site itself is a small
        demonstration. Every number below is enforced by a script that fails the build when it
        regresses, including the animation above, which cost zero bytes of JavaScript.
      </p>
      <div class="meas">
        <div>
          <span class="v">0<i> B</i></span>
          <span class="k">client JavaScript: a CI budget fails the build above zero</span>
        </div>
        <div>
          <span class="v">0<i> req</i></span>
          <span class="k">external requests: no fonts, no CDN, no analytics</span>
        </div>
        <div>
          <span class="v">&lt;20<i> KB</i></span>
          <span class="k">largest page, gzipped, styles inlined, budget-capped in CI</span>
        </div>
        <div>
          <span class="v">5<i> widths</i></span>
          <span class="k">overflow-checked in a real browser, 320 to 1280px</span>
        </div>
      </div>
      <p class="fine">
        Astro static · hand-written CSS · a content schema that refuses to build a case study
        without an <i>evidence</i> field · CI actions pinned to commit SHAs · deployed through the
        same gates it advertises. <a href="https://github.com/Sparli/sparli-dev">Read the source</a>.
      </p>
      <div class="cta2">
        <a class="btn" href="mailto:hello@sparli.dev">hello@sparli.dev</a>
        <span class="alt">
          Hiring an AI engineer for agents, integrations or data pipelines? Remote, or relocation
          with sponsorship. Send a real problem; it is faster than a screening call.
        </span>
      </div>
    </div>
  </div>
</Base>
