---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// The case studies are the depth. This page's job is to be scannable and to
// hand off, so each entry that HAS a write-up links to it rather than
// restating it.
//
// Looked up by id, and a miss throws rather than returning null. Returning null
// would silently drop the link and still build green, which is the failure this
// lookup exists to prevent: an entry that quietly stops pointing at its own
// evidence is worse than a build error, because nobody finds out. Entries with
// no write-up pass `link: null` directly and never reach this function.
const studies = new Map(
  (await getCollection("shipped", ({ data }) => !data.draft)).map((e) => [e.id, e]),
);
const study = (id: string) => {
  if (!studies.has(id)) {
    throw new Error(
      `cv.astro links to a case study that does not exist: "${id}". ` +
        `Known ids: ${[...studies.keys()].join(", ")}`,
    );
  }
  return `/shipped/${id}/`;
};

const delivery = [
  {
    title: "Shurq: data pipeline, MCP server and AI Ad Manager",
    period: "2022 to present",
    context: "UK Amazon-analytics SaaS, joined at idea stage, leading AI and data engineering",
    body: "Shurq is now a paid SaaS (670+ shipped releases) serving Amazon brands across <b>21 marketplaces</b>, with a 10+ person team and <b>200+ concurrent users</b>. I own the pipeline that pulls sales, fee and ad data from Amazon every hour and turns it into true per-product profit; every dashboard, alert and agent reads from it. I led and built the <b>MCP server</b>: 1,080 tools, 29 of them write actions, over streamable HTTP with scoped API keys, usable from Claude, ChatGPT, Cursor or Claude Code. And the <b>AI Ad Manager</b>: rules, scheduled workflows and an approval queue, every change logged and reversible, with LLM fallback from self-hosted Ollama to OpenAI.",
    link: null,
  },
  {
    title: "EduImmersion: AI learning platform and school-network dashboards",
    period: "2025 to present, in pilot",
    context: "Québec EdTech client, raw requirements to two shipped products",
    body: "A learner platform that generates lessons, quizzes and reflections by grade, language and pace, with a Premium tier on Stripe, and a role-based dashboard suite for school service centres, schools, teachers and parents. Both EN/FR, data hosted in Canada. Reworking the lesson-image prompts and text handling cut text-rendering errors by roughly 80% across 8 EN/FR scenarios, with no model change and no added cost or latency. An EN/FR-parity Playwright suite blocks a release when either language regresses.",
    link: null,
  },
  {
    title: "Voice agents that act in the CRM mid-call",
    period: "2026",
    context: "US payment-services client (sole engineer), Canadian SEO SaaS",
    body: "Outbound calling platform with Pipedrive dedupe, deal creation, callback scheduling, 10-scenario follow-up email routing and an SMS tool that sends a document during the call. Compliance built in: dialling windows, DNC scrubbing, mid-call opt-out detection, verbal-consent logging, CASL unsubscribes. The early hang-ups traced to speech-to-text hearing &ldquo;hello&rdquo; as &ldquo;no&rdquo;.",
    link: study("four-second-hangup"),
  },
  {
    title: "Agents with write access to business systems, made safe",
    period: "2025 to 2026",
    context: "Croncore delivery agent, and leadflow-agent (public)",
    body: "The Croncore agent triages pull requests, tracks tasks and drafts client mail; every side effect waits in a <b>pending_actions</b> row for a human, and each run is scoped to one project. <a href=\"https://github.com/Sparli/leadflow-agent\">leadflow-agent</a> turns an inbound enquiry into HubSpot records: a human approves each write, every action goes to a ledger with undo, and it costs under $0.002 per lead.",
    link: study("agent-that-cannot-email-clients"),
  },
  {
    title: "Arabic (Saudi-dialect) inbound sales agent",
    period: "2026",
    context: "Live on web and phone",
    body: "Answers in about 0.5 s, captures the lead and hands off to a human. Model fallback plus a scripted fallback means it never goes silent, and Twilio webhooks are signature-verified.",
    link: null,
  },
  {
    title: "Speech service into a legacy PBX",
    period: "2024",
    context: "Mongolian client, language with no commercial vendor",
    body: "Built and operated the serving stack: a self-hosted FastAPI service running two off-the-shelf engines behind one interface with fallback between them, producing audio that matched the client's existing Asterisk/FreePBX contract so nothing on the telephony side had to change.",
    link: study("mongolian-speech-legacy-pbx"),
  },
  {
    title: "Also built",
    period: "2025 to 2026",
    context: "Products and internal tools",
    body: "Offline-first retail POS (Tauri/Rust and React, ~380 automated tests). Live speech-to-speech translation with latency shown on screen. An MCP coordination server for coding agents. A prospect-research pipeline where nothing is sent without review. A multi-user time tracker on Cloudflare Workers and D1. Led a retrieval agent that quotes live prices from an automotive client's own data.",
    link: null,
  },
];

const experience = [
  {
    org: "Shurq",
    what: "UK Amazon-analytics SaaS, joined at idea stage",
    role: "Founding AI & Data Engineer, leading AI and data engineering",
    when: "Jul 2022 to present",
  },
  {
    org: "Croncore",
    what: "AI engineering consultancy",
    role: "Founder & Lead Engineer",
    when: "Jan 2025 to present",
  },
  {
    org: "Freelance",
    what: "AI and full-stack engineering for international clients",
    role: "Top Rated on Upwork",
    when: "2019 to 2022",
  },
];

const skills = [
  ["Languages", "Python · TypeScript/JavaScript · Node.js · SQL"],
  [
    "Agentic & LLM",
    "tool-using agents · MCP tool servers · Anthropic tool use · OpenAI function calling · schema-validated structured outputs · RAG · provider fallback · human-in-the-loop approval gates · prompt-injection containment · eval design and calibration",
  ],
  [
    "Backend & data",
    "FastAPI · Django/DRF · Next.js · PostgreSQL · pgvector · Redis · Celery · BigQuery · hourly ETL pipelines · Docker · rate limiting and backoff",
  ],
  [
    "Cloud & ops",
    "AWS · GCP · Azure · Vercel · Render · Cloudflare · GitHub Actions CI/CD · Prometheus/Grafana",
  ],
];

const integrations =
  "Amazon Ads & Selling Partner APIs · HubSpot · Pipedrive · Twilio · Asterisk/FreePBX · Deepgram · ElevenLabs · ClickUp · GitHub · Gmail · Google Sheets · Google Places · Stripe";
---

<Base
  title="CV · Sparli Aman"
  description="Senior AI engineer: agentic systems, integrations and data pipelines. Four years leading AI and data engineering at Shurq, plus client delivery in the US, Canada, the UK and the Gulf. Pakistan, UTC+5."
>
  <section class="cvhead">
    <h1>CV</h1>
    <p class="lede">
      Seven years shipping production software. The last four building the AI and data layer of
      Shurq from idea stage to 200+ concurrent users, alongside client delivery in the US, Canada,
      the UK and the Gulf. I want to go deep on one product with one team.
    </p>
    <p class="actions">
      <a class="dl" href="/Sparli_Aman_CV.pdf">Download the PDF</a>
      <span class="note">Two pages. Same facts, laid out for print.</span>
    </p>
  </section>

  <h2 class="section">Selected delivery</h2>
  <p class="sub">
    Most of this is client work under NDA, so each entry describes architecture and outcomes rather
    than showing source. Where there is a full write-up, it starts with what went wrong.
  </p>

  <ol class="entries">
    {
      delivery.map((d) => (
        <li class="entry">
          <div class="entry-head">
            <h3>{d.title}</h3>
            <span class="period">{d.period}</span>
          </div>
          <p class="context">{d.context}</p>
          <p class="body" set:html={d.body} />
          {d.link && (
            <a class="more" href={d.link}>
              Read the case study
            </a>
          )}
        </li>
      ))
    }
  </ol>

  <h2 class="section">Experience</h2>
  <ul class="rows">
    {
      experience.map((e) => (
        <li>
          <div class="rk">
            <b>{e.org}</b>, {e.what}
          </div>
          <div class="rv">
            {e.role}
            <span class="when">{e.when}</span>
          </div>
        </li>
      ))
    }
  </ul>

  <h2 class="section">Integrated with</h2>
  <p class="sub">Each one wired up and debugged in production, not read about.</p>
  <p class="prose">{integrations}</p>

  <h2 class="section">Skills</h2>
  <dl class="skills">
    {
      skills.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))
    }
  </dl>

  <h2 class="section">Education and availability</h2>
  <div class="prose">
    <p>
      BSc Software Engineering, Pak-Austria Fachhochschule, Institute of Applied Sciences and
      Technology, Pakistan.
    </p>
    <p>
      Remote, with working hours overlapping the EU in full and the US East coast by four hours.
      Open to relocation where the role offers visa sponsorship (Ireland, the EU, the UK). Open as an
      employee or on contract.
    </p>
  </div>

  <div class="cta">
    <p>
      <b>Hiring an AI engineer for agents, integrations or data pipelines?</b> Send me a real problem
      you are dealing with and I will tell you how I would approach it. That is faster than a
      screening call for both of us.
    </p>
    <p><a href="mailto:hello@sparli.dev">hello@sparli.dev</a></p>
  </div>
</Base>

<style>
  /* Scoped to this page. The shared classes in global.css cover the shell and
   * the prose; everything below is CV-specific layout that would be dead weight
   * on every other page. */

  .cvhead {
    padding: 40px 0 4px;
  }
  .cvhead h1 {
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .cvhead .lede {
    max-width: var(--measure);
    font-size: 1.06rem;
    color: var(--muted);
    margin: 0 0 22px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 14px;
    margin: 0;
  }
  .dl {
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--raised);
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
  }
  .dl:hover {
    border-color: var(--accent);
  }
  .note {
    color: var(--faint);
    font-size: 0.88rem;
  }

  .entries {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
  }
  .entry {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .entry:first-child {
    border-top: 0;
    padding-top: 6px;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  .entry-head h3 {
    margin: 0;
    font-size: 1.06rem;
    line-height: 1.34;
    /* Without this the title refuses to shrink and pushes the row wider than
     * the viewport on a narrow phone. */
    min-width: 0;
  }
  .period {
    color: var(--faint);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .context {
    margin: 3px 0 8px;
    color: var(--faint);
    font-size: 0.88rem;
    font-style: italic;
  }
  .body {
    margin: 0;
    max-width: var(--measure);
    color: var(--muted);
  }

  .more {
    display: inline-block;
    margin-top: 9px;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .more::after {
    content: " \2192";
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: grid;
    gap: 2px 20px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
  }
  .rows li:first-child {
    border-top: 0;
  }
  .rk {
    min-width: 0;
  }
  .rv {
    color: var(--muted);
    font-size: 0.94rem;
    min-width: 0;
  }
  .when {
    display: block;
    color: var(--faint);
    font-size: 0.85rem;
  }

  @media (min-width: 720px) {
    .rows li {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    .rv {
      text-align: right;
    }
  }

  .skills {
    display: grid;
    gap: 4px 22px;
    margin: 0;
    max-width: var(--measure);
  }
  .skills dt {
    font-weight: 650;
    font-size: 0.9rem;
    min-width: 0;
  }
  .skills dd {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.95rem;
    min-width: 0;
  }

  @media (min-width: 720px) {
    .skills {
      grid-template-columns: 150px 1fr;
    }
    .skills dd {
      margin-bottom: 6px;
    }
  }
</style>
